{
  "name": "word-gpt-plus",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.{vue,css}\" --max-warnings 0",
    "cz": "czg",
    "release": "bump-version",
    "lint:dpdm": "dpdm -T --tsconfig ./tsconfig.json --no-tree --no-warning --exit-code circular:1 src/main.ts",
    "preinstall": "node scripts/check-toolchain.mjs",
    "prepare": "husky",
    "typecheck": "vue-tsc --noEmit",
    "lint:style:fix": "pnpm lint:style --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm lint:style && pnpm typecheck && pnpm lint:dpdm"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.6.2",
    "@lucide/vue": "^1.56.0",
    "@vueuse/core": "^15.0.0",
    "dexie": "^4.4.6",
    "langchain": "^1.5.16",
    "mathjs": "^15.2.0",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/office-js": "^1.0.611",
    "@vitejs/plugin-vue": "^6.0.10",
    "czg": "^1.14.0",
    "dpdm": "^4.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.3.0",
    "node-bump-version": "^3.0.0",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.11.2"
  },
  "packageManager": "pnpm@12.11.2"
}
